#!/usr/bin/env bash
# Runs `./brainfm play focus` continuously, killing it at :50 and restarting at :00

set -euo pipefail

CMD="./target/release/brainfm play focus"
PID=""

cleanup() {
  echo "Interrupted. Killing brainfm..."
  [ -n "$PID" ] && kill "$PID" 2>/dev/null
  exit 0
}
trap cleanup INT TERM

kill_brainfm() {
  if [ -n "$PID" ]; then
    echo "[$(date +%H:%M:%S)] Killing brainfm (PID $PID)..."
    kill "$PID" 2>/dev/null
    wait "$PID" 2>/dev/null || true
    PID=""
  fi
}

start_brainfm() {
  echo "[$(date +%H:%M:%S)] Starting brainfm..."
  $CMD &
  PID=$!
  echo "[$(date +%H:%M:%S)] brainfm started (PID $PID)"
}

wait_until_minute() {
  local target=$1  # e.g. 50 or 0
  echo "[$(date +%H:%M:%S)] Waiting until :$(printf '%02d' $target)..."
  while [ "$(date +%-M)" -ne "$target" ]; do
    sleep 5
  done
}

# Start immediately if we're in the :00–:49 window
current_min=$(date +%-M)
if [ "$current_min" -lt 50 ]; then
  start_brainfm
  wait_until_minute 50
else
  echo "[$(date +%H:%M:%S)] Currently past :50, waiting until :00..."
  wait_until_minute 0
fi

while true; do
  kill_brainfm
  wait_until_minute 0
  start_brainfm
  wait_until_minute 50
done
